analysis/calibrated.json

# scripts and reports about extracting the database key (and the decryption reports)
tools/grt_extract_key.sh
tools/grt_*report*.txt

# sample loads and screenshots taken from the original program
*.grtload
*.grtreload
!data/measurements/*.grtload
!tests/fixtures/*.grtload
tests/data/

# reverse-engineering notes and the project instructions that describe them
CLAUDE.md
.claude/

# files exchanged with the VM that runs the original program
results/
*.log

# manufacturer catalogues used as data sources (not ours to redistribute)
/Vectan-Reloading-catalogue*.pdf

# downloaded manufacturer data (manuals, web pages, sample files): local only, see scripts/data/loaddata/README.md
/scripts/data/loaddata/sources/
/*.pdf
