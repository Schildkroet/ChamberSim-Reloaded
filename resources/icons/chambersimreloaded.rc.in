#include <winver.h>

IDI_ICON1 ICON "@CSR_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ChamberSim Reloaded\0"
            VALUE "FileDescription", "ChamberSim Reloaded - interior ballistics for handloaders\0"
            VALUE "FileVersion", "@CSR_VERSION@\0"
            VALUE "InternalName", "ChamberSimReloaded\0"
            VALUE "OriginalFilename", "ChamberSimReloaded.exe\0"
            VALUE "ProductName", "ChamberSim Reloaded\0"
            VALUE "ProductVersion", "@CSR_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
